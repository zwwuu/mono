{
    "intake": {
        "done_dir": "done",
        "failed_dir": "failed",
        "incoming_dir": "incoming",
        "root": "/srv/ftp1",
        "transport": "local"
    },
    "jobs": [
        "monthly-report"
    ],
    "ledger_db": "/var/lib/fileflow-watcher/watcher.db",
    "log_file": "/var/log/fileflow-watcher/watcher.log",
    "notify": {
        "from": "watcher@example.com",
        "password_env": "WATCHER_SMTP_PASSWORD",
        "smtp_host": "smtp.example.com",
        "smtp_port": 587,
        "to": "ops@example.com",
        "username": "watcher@example.com"
    },
    "outbound": {
        "archive_dir": "upload-archive",
        "min_age_seconds": 2,
        "requests_dir": "upload-requests"
    },
    "processing": {
        "failed_dir": "failed",
        "host": "ftp2.example.com",
        "password_env": "WATCHER_FTP2_PASSWORD",
        "port": 21,
        "processing_dir": "processing",
        "success_dir": "success",
        "transport": "ftp",
        "username": "watcher"
    },
    "share_root": "/mnt/share",
    "stale_after_seconds": 86400
}