{
    "destination": {
        "directory": "reports/{year}{month}",
        "root": "demo-out/ftp",
        "transport": "local"
    },
    "job": "monthly-report",
    "category": "pdf",
    "ledger_db": "demo-out/agent.db",
    "log_file": "demo-out/agent.log",
    "procedure": "rename-pdf-report",
    "procedures_module": "procedures_local",
    "rename_pattern": "{name}{ext}",
    "source": {
        "actions": [
            {
                "action": "goto",
                "url": "http://127.0.0.1:8901/"
            },
            {
                "action": "fill",
                "selector": "#username",
                "value": "demo"
            },
            {
                "action": "fill",
                "secret_env": "DEMO_PORTAL_PASSWORD",
                "selector": "#password"
            },
            {
                "action": "click",
                "selector": "button[type=submit]"
            },
            {
                "action": "wait_for",
                "selector": "a.download",
                "timeout_seconds": 30
            },
            {
                "action": "download",
                "selector": "a.download",
                "timeout_seconds": 60
            }
        ],
        "headless": true,
        "timeout_seconds": 60,
        "type": "playwright"
    },
    "staging_dir": "demo-out/staging"
}
