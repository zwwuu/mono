{
  "tasks": [
    {
      "approval_after": [
        "fetch",
        "rename",
        "copy"
      ],
      "destinations": [
        {
          "dir": "approved",
          "type": "local"
        }
      ],
      "enabled": true,
      "id": "scenario-multi-approval",
      "name": "Scenario: approvals after download, rename and move",
      "notify": true,
      "rename": "{date}_{name}{ext}"
    },
    {
      "approval": false,
      "destinations": [
        {
          "dir": "direct",
          "type": "local"
        },
        {
          "dir": "direct-share",
          "type": "smb"
        }
      ],
      "enabled": true,
      "id": "scenario-no-approval",
      "name": "Scenario: no approval at all",
      "notify": false,
      "rename": "{date}_{name}{ext}"
    },
    {
      "enabled": true,
      "id": "scenario-no-destination",
      "name": "Scenario: no final destination, no processing",
      "steps": [
        {
          "type": "fetch"
        },
        {
          "type": "checksum"
        },
        {
          "pattern": "{date}_{name}{ext}",
          "type": "rename"
        }
      ]
    },
    {
      "enabled": true,
      "id": "scenario-process-before-rename",
      "name": "Scenario: processing happens before rename and copy",
      "steps": [
        {
          "type": "fetch"
        },
        {
          "type": "checksum"
        },
        {
          "to": {
            "dir": "inbox",
            "type": "ftp"
          },
          "type": "copy"
        },
        {
          "dir": "processed",
          "pattern": "{current_name}",
          "type": "wait_processed"
        },
        {
          "type": "fetch_processed"
        },
        {
          "pattern": "PROC-{date}_{name}{ext}",
          "type": "rename"
        },
        {
          "to": {
            "dir": "processed-out",
            "type": "local"
          },
          "type": "copy"
        }
      ]
    },
    {
      "destinations": [
        {
          "dir": "inbox",
          "type": "ftp"
        },
        {
          "dir": "final",
          "type": "local"
        }
      ],
      "enabled": true,
      "id": "scenario-process-then-copy",
      "name": "Scenario: processing first, then copy onward",
      "notify": true,
      "processing": {
        "dir": "processed",
        "pattern": "{renamed_name}"
      },
      "rename": "{date}_{name}{ext}"
    },
    {
      "enabled": true,
      "id": "scenario-conditional-notify",
      "name": "Scenario: conditional notification",
      "steps": [
        {
          "type": "fetch"
        },
        {
          "type": "checksum"
        },
        {
          "pattern": "{date}_{name}{ext}",
          "type": "rename"
        },
        {
          "to": {
            "dir": "conditional",
            "type": "local"
          },
          "type": "copy"
        },
        {
          "subject": "[FileFlow] big file: {current_name}",
          "template": "File {current_name} is {downloaded_size} bytes, over the threshold.",
          "type": "notify",
          "when": {
            "field": "downloaded_size",
            "op": "gt",
            "value": 1000000
          }
        },
        {
          "subject": "[FileFlow] done: {current_name}",
          "template": "Task {task} finished {current_name} (sha256 {sha256}).",
          "type": "notify",
          "when": {
            "field": "sha256",
            "op": "exists"
          }
        }
      ]
    },
    {
      "enabled": true,
      "failure_subject": "[FileFlow] {task} FAILED at {step}: {error}",
      "failure_template": "Task {task} run #{run_id} failed at step {step}.\nReason: {error}\nFile: {current_name}\n",
      "id": "scenario-custom-templates",
      "name": "Scenario: custom success and failure templates",
      "steps": [
        {
          "type": "fetch"
        },
        {
          "type": "checksum"
        },
        {
          "pattern": "{date}_{name}{ext}",
          "type": "rename"
        },
        {
          "failure_subject": "[FileFlow] {task} COPY FAILED: {error}",
          "failure_template": "Copy step failed for {current_name}: {error}\n",
          "to": {
            "dir": "templated",
            "type": "local"
          },
          "type": "copy"
        },
        {
          "type": "notify",
          "subject": "[FileFlow] {task} done: {current_name}",
          "template": "Task {task} completed {current_name}.\nSHA-256: {sha256}\n"
        }
      ]
    },
    {
      "approval": false,
      "destinations": [
        {
          "dir": "local-source-out",
          "type": "local"
        }
      ],
      "enabled": true,
      "id": "scenario-local-source",
      "name": "Scenario: local source file, no download",
      "notify": false,
      "rename": "LOCAL-{date}_{name}{ext}",
      "source": {
        "path": "demo_source/input_report.csv",
        "type": "local"
      }
    },
    {
      "enabled": true,
      "id": "scenario-progress-notify",
      "name": "Scenario: progress email mid-pipeline",
      "steps": [
        {
          "type": "fetch"
        },
        {
          "subject": "[FileFlow] fetched {downloaded_name}",
          "template": "Task {task} fetched {downloaded_name} ({downloaded_size} bytes), checksum pending.",
          "type": "notify"
        },
        {
          "type": "checksum"
        },
        {
          "pattern": "{date}_{name}{ext}",
          "type": "rename"
        },
        {
          "to": {
            "dir": "progress",
            "type": "local"
          },
          "type": "copy"
        }
      ]
    },
    {
      "approval_after": [
        "copy"
      ],
      "destinations": [
        {
          "dir": "gate-a",
          "type": "local"
        },
        {
          "dir": "gate-b",
          "type": "local"
        }
      ],
      "enabled": true,
      "id": "scenario-approval-after-every-copy",
      "name": "Scenario: approval after every move",
      "notify": false,
      "rename": "{date}_{name}{ext}"
    },
    {
      "id": "scenario-ftp-source",
      "name": "Scenario: initial file is on FTP",
      "source": {
        "type": "ftp",
        "dir": "inbox",
        "pattern": "report-*.csv",
        "sort": "newest"
      },
      "approval": false,
      "rename": "{date}_{name}{ext}",
      "destinations": [
        {
          "type": "local",
          "dir": "ftp-picked"
        }
      ],
      "notify": false
    },
    {
      "id": "scenario-smb-source",
      "name": "Scenario: initial file is on a share",
      "source": {
        "type": "smb",
        "dir": "share",
        "pattern": "data-*.csv"
      },
      "approval": false,
      "rename": "{date}_{name}{ext}",
      "destinations": [
        {
          "type": "local",
          "dir": "smb-picked"
        }
      ],
      "notify": false
    },
    {
      "id": "scenario-local-dir-source",
      "name": "Scenario: initial file is in a local dir",
      "source": {
        "type": "local",
        "dir": "inbox",
        "pattern": "*.csv",
        "sort": "newest"
      },
      "approval": false,
      "rename": "{date}_{name}{ext}",
      "destinations": [
        {
          "type": "local",
          "dir": "dir-picked"
        }
      ],
      "notify": false
    },
    {
      "id": "scenario-browser-source",
      "name": "Scenario: download by logging into a portal",
      "source": {
        "type": "browser",
        "actions": [
          {
            "action": "goto",
            "url": "https://portal.example.com/login"
          },
          {
            "action": "fill",
            "selector": "#username",
            "value": "alice"
          },
          {
            "action": "fill",
            "selector": "#password",
            "secret": "PORTAL_PASSWORD"
          },
          {
            "action": "click",
            "selector": "button[type=submit]"
          },
          {
            "action": "wait_for",
            "selector": "a.download"
          },
          {
            "action": "download",
            "selector": "a.download"
          }
        ]
      },
      "approval": false,
      "rename": "{date}_{name}{ext}",
      "destinations": [
        {
          "type": "local",
          "dir": "portal"
        }
      ],
      "notify": false
    },
    {
      "id": "scenario-browser-table-row",
      "name": "Scenario: download the row titled X from a table",
      "source": {
        "type": "browser",
        "actions": [
          {
            "action": "goto",
            "url": "https://portal.example.com/files"
          },
          {
            "action": "download",
            "selector": {
              "kind": "row",
              "table": "#files",
              "column": "Title",
              "match": {
                "equals": "Q3 Report"
              },
              "target": "a.download"
            }
          }
        ]
      },
      "approval": false,
      "rename": "{date}_{name}{ext}",
      "destinations": [
        {
          "type": "local",
          "dir": "portal-rows"
        }
      ],
      "notify": false
    },
    {
      "id": "scenario-run-limit",
      "name": "Scenario: at most 3 runs per day",
      "approval": false,
      "notify": false,
      "run_limit": {
        "max": 3,
        "period": "day"
      },
      "rename": "{date}_{name}{ext}",
      "destinations": [
        {
          "type": "local",
          "dir": "limited"
        }
      ]
    }
  ]
}