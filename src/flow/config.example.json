{
  "app": {
    "data_dir": "./data",
    "host": "127.0.0.1",
    "port": 8080,
    "log_level": "INFO",
    "log_retention_days": 30
  },
  "demo": {
    "enabled": false,
    "process_delay_seconds": 8,
    "source_file": "input_report.csv"
  },
  "ftp": {
    "host": "ftp.example.com",
    "port": 21,
    "username": "fileflow",
    "timeout_seconds": 30,
    "poll_seconds": 5
  },
  "notify": {
    "on_stuck": true,
    "recipients": [
      "ops-team@example.com"
    ]
  },
  "scheduler": {
    "allow_overlap": false,
    "tick_seconds": 20
  },
  "smb": {
    "mode": "path",
    "path": "",
    "server": "",
    "share": "",
    "target_dir": "/mnt/share/fileflow",
    "username": ""
  },
  "smtp": {
    "from": "fileflow@example.com",
    "host": "smtp.example.com",
    "port": 587,
    "security": "starttls",
    "username": "fileflow@example.com"
  },
  "source": {
    "timeout_seconds": 60
  },
  "steps": {
    "timeout_seconds": 300
  }
}